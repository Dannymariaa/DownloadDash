{
  "expo": {
    "name": "DownloadDash",
    "slug": "downloaddash",
    "scheme": "downloaddash",
    "version": "1.0.0",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTabletMode": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to save downloaded content."
      }
    },
    "android": {
      "package": "com.downloaddash.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [],
    "icon": "./assets/app-icon.png",
    "splash": {
      "image": "./assets/app-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "extra": {
      "apiBaseUrl": "https://api.downloaddash.store",
      "requireApiKey": false,
      "ads": {
        "provider": "adsterra",
        "units": {
          "nativeBanner": {
            "id": "30079457",
            "format": "native",
            "key": "c1a1efe79c0f2963e83460ce138fae10"
          },
          "banner320x50": {
            "id": "30079458",
            "format": "iframe",
            "key": "25fdf0e506fec8285d21a27d4bc83eb2",
            "width": 320,
            "height": 50
          },
          "banner728x90": {
            "id": "30079459",
            "format": "iframe",
            "key": "630c6c9a5f2b0f771022aff6e8e18ca7",
            "width": 728,
            "height": 90
          },
          "banner300x250": {
            "id": "30079460",
            "format": "iframe",
            "key": "25fdf0e506fec8285d21a27d4bc83eb2",
            "width": 300,
            "height": 250
          }
        }
      }
    }
  }
}

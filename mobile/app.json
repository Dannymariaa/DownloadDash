{
  "expo": {
    "name": "DownloadDash",
    "slug": "downloaddash",
    "scheme": "downloaddash",
    "version": "1.0.0",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTabletMode": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to save downloaded content."
      }
    },
    "android": {
      "package": "com.downloaddash.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [],
    "icon": "./assets/app-icon.png",
    "splash": {
      "image": "./assets/app-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "extra": {
      "apiBaseUrl": "https://api.downloaddash.store",
      "requireApiKey": false,
      "ads": {
        "provider": "monetag",
        "format": "multitag",
        "scriptSrc": "https://3nbf4.com/88/tag.min.js",
        "zoneId": "11099484",
        "zones": {
          "pushNotifications": "11099484",
          "vignetteBanner": "11099483",
          "inPagePush": "11099482",
          "onclickPopunder": "11099481"
        },
        "dataCfasync": "false"
      }
    }
  }
}

# =========================
# DownloadDash AI Email Responder Pro
# =========================

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Website / brand
BRAND_NAME=DownloadDash
WEBSITE_URL=https://www.downloaddash.store
SUPPORT_EMAIL=support@downloaddash.store
INFO_EMAIL=info@downloaddash.store
LEGAL_EMAIL=legal@downloaddash.store

# How often the bot checks mail, in seconds
CHECK_INTERVAL_SECONDS=60

# Safety modes
# true = support/info can be sent automatically after AI analysis
AUTO_SEND_SUPPORT=true
AUTO_SEND_INFO=true
# Legal should usually stay false. It will create a draft-style prepared reply in logs or forward to reviewer.
AUTO_SEND_LEGAL=false

# Optional human reviewer email for legal or risky emails.
# Example: your personal Gmail
HUMAN_REVIEW_EMAIL=

# IMAP and SMTP settings for Namecheap Private Email
IMAP_HOST=mail.privateemail.com
IMAP_PORT=993
IMAP_SECURE=true
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_SECURE=true

# Mailbox login details
SUPPORT_USER=support@downloaddash.store
SUPPORT_PASS=your_support_mailbox_password
INFO_USER=info@downloaddash.store
INFO_PASS=your_info_mailbox_password
LEGAL_USER=legal@downloaddash.store
LEGAL_PASS=your_legal_mailbox_password

# Optional: comma-separated emails/domains the bot must never reply to
BLOCKLIST=no-reply@example.com,mailer-daemon,postmaster

# Optional: prevent too many replies to same sender in one day
MAX_REPLIES_PER_SENDER_PER_DAY=3

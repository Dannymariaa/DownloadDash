# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=0

# Proxy Configuration (Optional - supports socks5, http, https)
# Format: protocol://user:pass@host:port or protocol://host:port
PROXY=http://proxy.example.com:8080

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# API Configuration
DOWNLOADDASH_API_KEY=
API_TIMEOUT=15
CACHE_TTL=86400

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# Platform-specific configurations
YOUTUBE_PRIORITY=mp4
TIKTOK_NO_WATERMARK=true
INSTAGRAM_QUALITY=high

# Logging
LOG_LEVEL=INFO
LOG_BANDWIDTH=true

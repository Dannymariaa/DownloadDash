{
  "framework": "vite",

  "buildCommand": "npm run build",

  "outputDirectory": "dist",

  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },

  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],

  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/((?!api/|downloads/|sw\\.js$).*)",
      "destination": "/index.html"
    }
  ]
}

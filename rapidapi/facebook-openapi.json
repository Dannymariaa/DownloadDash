            "nullable": true
          },
          "audio_sample_rate": {
            "type": "integer",
            "title": "Audio Sample Rate",
            "nullable": true
          }
        },
        "type": "object",
        "required": [
          "id",
          "platform",
          "media_type",
          "url"
        ],
        "title": "MediaInfo"
      },
      "MediaType": {
        "type": "string",
        "enum": [
          "video",
          "image",
          "photo",
          "audio",
          "story",
          "status",
          "reel",
          "post",
          "carousel",
          "album",
          "profile_picture",
          "highlight",
          "live",
          "unknown"
        ],
        "title": "MediaType",
        "description": "Media types for downloaded content - FIXED to match Instagram API"
      },
      "Platform": {
        "type": "string",
        "enum": [
          "instagram",
          "tiktok",
          "facebook",
          "reddit",
          "pinterest",
          "twitter",
          "x",
          "youtube",
          "whatsapp",
          "whatsapp_business",
          "telegram",
          "linkedin",
          "threads",
          "twitch",
          "vimeo",
          "dailymotion",
          "spotify",
          "soundcloud"
        ],
        "title": "Platform"
      },
      "Quality": {
        "type": "string",
        "enum": [
          "lowest",
          "low",
          "medium",
          "high",
          "highest",
          "audio_only",
          "video_only",
          "144p",
          "240p",
          "360p",
          "480p",
          "720p",
          "1080p",
          "1440p",
          "2160p",
          "4320p"
        ],
        "title": "Quality"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",

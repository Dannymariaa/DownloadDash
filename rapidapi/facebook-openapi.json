      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  },
  "externalDocs": {
    "description": "DownloadDash API documentation and support",
    "url": "https://downloaddash.store"
  }
}
